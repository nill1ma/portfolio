---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout>
  <Header />

  <main class="main">
    <section id="hero" class="hero">
      <div class="hero-left">
        <p class="hero-greeting" data-i18n="hero.greeting">Olá, meu nome é</p>
        <h1 class="hero-name">Avanilson Santos</h1>
        <p class="hero-role" data-i18n="hero.role">Senior Frontend Developer</p>
        <p class="hero-bio" data-i18n="hero.bio">Mais de 10 anos construindo interfaces modernas, acessíveis, com suporte a PWA e bem testadas — com Jest, React Testing Library, Cypress e Playwright. Atualmente na Ci&amp;T.</p>
        <div class="hero-links">
          <a href="https://github.com/nill1ma" target="_blank" rel="noopener noreferrer" class="hero-link" aria-label="GitHub de Avanilson Santos">GitHub</a>
          <a href="https://www.linkedin.com/in/avanilson-santos-88113768" target="_blank" rel="noopener noreferrer" class="hero-link" aria-label="LinkedIn de Avanilson Santos">LinkedIn</a>
        </div>
      </div>
      <div class="hero-right">
        <div class="device-mockups" aria-hidden="true">
          <svg class="device-laptop" viewBox="0 0 360 240" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="6" width="320" height="196" rx="10" stroke="var(--mockup-s1)" stroke-width="2"/>
            <rect x="34" y="18" width="292" height="172" rx="4" stroke="var(--mockup-s1)" stroke-width="1.2"/>
            <circle cx="180" cy="12" r="2.5" stroke="var(--mockup-s1)" stroke-width="1.2"/>
            <line x1="54" y1="40" x2="180" y2="40" stroke="var(--mockup-s1)" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="54" y1="52" x2="140" y2="52" stroke="var(--mockup-s2)" stroke-width="1" stroke-linecap="round"/>
            <rect x="54" y="68" width="110" height="7" rx="2" stroke="var(--mockup-s2)" stroke-width="1"/>
            <rect x="54" y="80" width="80" height="7" rx="2" stroke="var(--mockup-s3)" stroke-width="1"/>
            <rect x="200" y="34" width="110" height="80" rx="6" stroke="var(--mockup-s2)" stroke-width="1.2"/>
            <rect x="54" y="118" width="252" height="5" rx="2" stroke="var(--mockup-s3)" stroke-width="1"/>
            <rect x="54" y="130" width="190" height="5" rx="2" stroke="var(--mockup-s4)" stroke-width="1"/>
            <rect x="54" y="142" width="220" height="5" rx="2" stroke="var(--mockup-s4)" stroke-width="1"/>
            <rect x="0" y="202" width="360" height="18" rx="4" stroke="var(--mockup-s1)" stroke-width="2"/>
            <rect x="140" y="208" width="80" height="8" rx="2" stroke="var(--mockup-s2)" stroke-width="1"/>
            <path d="M0 220 L10 236 L350 236 L360 220 Z" stroke="var(--mockup-s2)" stroke-width="1.5" fill="none"/>
          </svg>
          <svg class="device-phone" viewBox="0 0 90 170" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="84" height="164" rx="14" stroke="var(--mockup-s1)" stroke-width="2"/>
            <rect x="28" y="10" width="34" height="8" rx="4" stroke="var(--mockup-s1)" stroke-width="1.2"/>
            <line x1="32" y1="158" x2="58" y2="158" stroke="var(--mockup-s1)" stroke-width="2" stroke-linecap="round"/>
            <rect x="12" y="26" width="66" height="10" rx="3" stroke="var(--mockup-s2)" stroke-width="1.2"/>
            <rect x="12" y="44" width="66" height="44" rx="5" stroke="var(--mockup-s2)" stroke-width="1.2"/>
            <line x1="12" y1="98" x2="66" y2="98" stroke="var(--mockup-s3)" stroke-width="1" stroke-linecap="round"/>
            <line x1="12" y1="108" x2="50" y2="108" stroke="var(--mockup-s4)" stroke-width="1" stroke-linecap="round"/>
            <rect x="12" y="120" width="30" height="26" rx="4" stroke="var(--mockup-s3)" stroke-width="1"/>
            <rect x="48" y="120" width="30" height="26" rx="4" stroke="var(--mockup-s3)" stroke-width="1"/>
          </svg>
        </div>
      </div>
      <a href="#sobre" class="hero-scroll" aria-label="Rolar para o conteúdo">
        <span>scroll</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </section>

    <section id="technologies" class="section">
      <h2 class="section-title" data-i18n="technologies.title">Tecnologias</h2>
      <div class="tech-section-badges">
        <span class="tech-badge"><img src="/icons/react.svg" alt="" />React</span>
        <span class="tech-badge"><img src="/icons/nextjs.svg" alt="" />Next.js</span>
        <span class="tech-badge"><img src="/icons/typescript.svg" alt="" />TypeScript</span>
        <span class="tech-badge"><img src="/icons/javascript.svg" alt="" />JavaScript</span>
        <span class="tech-badge"><img src="/icons/tailwind.svg" alt="" />Tailwind CSS</span>
        <span class="tech-badge"><img src="/icons/styledcomponents.svg" alt="" />Styled Components</span>
        <span class="tech-badge"><img src="/icons/supabase.svg" alt="" />Supabase</span>
        <span class="tech-badge"><img src="/icons/vercel.svg" alt="" />Vercel</span>
        <span class="tech-badge"><img src="/icons/nodejs.svg" alt="" />Node.js</span>
        <span class="tech-badge"><img src="/icons/nestjs.svg" alt="" />NestJS</span>
        <span class="tech-badge"><img src="/icons/express.svg" alt="" />Express</span>
        <span class="tech-badge"><img src="/icons/pwa.svg" alt="" />PWA</span>
        <span class="tech-badge"><img src="/icons/cloudflare.svg" alt="" />Cloudflare</span>
        <span class="tech-badge"><img src="/icons/redux.svg" alt="" />Redux</span>
        <span class="tech-badge"><img src="/icons/zustand-icon.svg" alt="" />Zustand</span>
        <span class="tech-badge"><img src="/icons/react-query.svg" alt="" />React Query</span>
      </div>
    </section>

    <section id="sobre" class="section">
      <h2 class="section-title" data-i18n="about.title">Sobre</h2>
      <p class="section-text" data-i18n="about.text">
        Desenvolvedor Frontend Sênior com mais de 10 anos de experiência construindo interfaces modernas com React, Next.js e TypeScript. Apaixonado por performance, acessibilidade e boas práticas de desenvolvimento.
      </p>
    </section>


    <section id="experiencia" class="section">
      <h2 class="section-title" data-i18n="experience.title">Experiência</h2>
      <div class="exp-list">
        <div class="exp-item">
          <div class="exp-header">
            <span class="exp-company">Ci&amp;T</span>
            <span class="exp-period">jan/2024 — <span data-i18n="experience.present">presente</span></span>
          </div>
          <span class="exp-role">Senior Frontend Developer</span>
          <div class="exp-stack">
            <span>React</span><span>TypeScript</span><span>Next.js</span><span>Tailwind CSS</span><span>Jest</span><span>Playwright</span>
          </div>
        </div>
        <div class="exp-item">
          <div class="exp-header">
            <span class="exp-company">NTT</span>
            <span class="exp-period">out/2023 — jan/2024</span>
          </div>
          <span class="exp-role">Senior Frontend Developer</span>
          <div class="exp-stack">
            <span>React</span><span>TypeScript</span><span>Styled Components</span>
          </div>
        </div>
        <div class="exp-item">
          <div class="exp-header">
            <span class="exp-company">ThoughtWorks</span>
            <span class="exp-period">mar/2021 — ago/2023</span>
          </div>
          <span class="exp-role">Senior Frontend Developer</span>
          <div class="exp-stack">
            <span>React</span><span>TypeScript</span><span>Next.js</span><span>Redux</span><span>Cypress</span><span>Testing Library</span>
          </div>
        </div>
        <div class="exp-item exp-item--earlier">
          <span class="exp-earlier-label" data-i18n="experience.earlier">Anteriormente</span>
          <p class="exp-earlier-desc" data-i18n="experience.earlierDesc">Capgemini, Accenture, FCamara, Solutis, Mazzatech, Iteris (2013–2021) — projetos em Angular, Vue.js, PHP, Java Spring Boot e React, em setores como financeiro, varejo e setor público.</p>
        </div>
      </div>
    </section>

    <section id="projetos" class="section">
      <h2 class="section-title" data-i18n="projects.title">Projetos</h2>
      <div class="projects-grid">
        <ProjectCard
          name="monthctrl-web"
          image="/images/monthctrl.jpg"
          description="Gerenciador de tarefas mensais com foco em produtividade e organização pessoal."
          i18nKey="projects.monthctrl.description"
          stack={["Next.js", "TypeScript", "Tailwind CSS", "Supabase", "Vercel", "awake-ui", "Jest", "Testing Library", "Playwright"]}
          githubUrl="https://github.com/nill1ma/monthctrl-web"
          liveUrl="https://monthctrl-app.vercel.app/login"
        />
        <ProjectCard
          name="awakr"
          image="/images/awakr.jpg"
          description="Site institucional para criação de sites para restaurantes e negócios locais, com CMS Sanity, domínio próprio e PWA."
          i18nKey="projects.awakr.description"
          stack={["Astro", "React", "Sanity", "Tailwind CSS", "Cloudflare", "awake-ui"]}
          liveUrl="https://awakr.app"
        />
        <ProjectCard
          name="CycleHabits"
          image="/images/cyclehabits.jpg"
          description="PWA para acompanhamento de hábitos diários como vitaminas, treinos e rotinas, com notificações push e suporte a múltiplos idiomas."
          i18nKey="projects.cyclehabits.description"
          stack={["React", "TypeScript", "Vite", "Tailwind CSS", "Firebase", "Cloudflare", "PWA", "OneSignal", "awake-ui", "Vitest", "Testing Library"]}
          githubUrl="https://github.com/cyclehabits/cyclehabits"
          liveUrl="https://cyclehabits.app"
        />
        <ProjectCard
          name="awake-ui"
          image="/images/awake-ui.jpg"
          description="Biblioteca de componentes UI para React, inspirada no Material UI, para uso em projetos pessoais e profissionais."
          i18nKey="projects.awakeui.description"
          stack={["React", "TypeScript", "Tailwind CSS", "Storybook", "Vite", "Vitest", "Playwright", "Vercel"]}
          githubUrl="https://github.com/nill1ma/awake-ui"
          liveUrl="https://awake-ui.vercel.app"
        />
      </div>
    </section>

    <section id="contato" class="section contact-section">
      <h2 class="section-title" data-i18n="contact.title">Vamos conversar?</h2>
      <p class="contact-subtitle" data-i18n="contact.subtitle">Aberto a oportunidades remotas no Brasil e no exterior.</p>
      <form
        action="https://formspree.io/f/xpwzgool"
        method="POST"
        class="contact-form"
      >
        <div class="form-row">
          <input type="text" name="name" placeholder="Seu nome" required aria-label="Seu nome" data-i18n-placeholder="contact.namePlaceholder" />
          <input type="email" name="email" placeholder="Seu e-mail" required aria-label="Seu e-mail" data-i18n-placeholder="contact.emailPlaceholder" />
        </div>
        <textarea name="message" rows="4" placeholder="Mensagem" required aria-label="Mensagem" data-i18n-placeholder="contact.messagePlaceholder"></textarea>
        <button type="submit" class="cta-btn" data-i18n="contact.send">Enviar mensagem</button>
      </form>
      <p class="contact-alt" data-i18n="contact.alt">Ou direto pelo <a href="mailto:avanilson.limasantos@gmail.com">e-mail</a> ou <a href="https://www.linkedin.com/in/avanilson-santos-88113768" target="_blank" rel="noopener">LinkedIn</a>.</p>
    </section>
  </main>

<div id="stack-tooltip" style="position:fixed;background:#18181b;color:#fff;font-size:0.7rem;padding:3px 8px;border-radius:4px;pointer-events:none;white-space:nowrap;z-index:9999;opacity:0;transition:opacity 0.15s;"></div>

<script>
  const tip = document.getElementById('stack-tooltip');
  if (tip) {
    document.querySelectorAll('.stack-bubble[data-tooltip]').forEach(el => {
      const element = el as HTMLElement;
      element.addEventListener('mouseenter', () => {
        tip.textContent = element.dataset.tooltip || '';
        tip.style.opacity = '1';
      });
      element.addEventListener('mousemove', (e: MouseEvent) => {
        tip.style.left = (e.clientX - tip.offsetWidth / 2) + 'px';
        tip.style.top = (e.clientY - tip.offsetHeight - 10) + 'px';
      });
      element.addEventListener('mouseleave', () => {
        tip.style.opacity = '0';
      });
    });
  }


  // URL sync ao scroll
  const sections = [
    { id: 'hero', hash: '' },
    { id: 'sobre', hash: '#sobre' },
    { id: 'projetos', hash: '#projetos' },
  ];
  const urlObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const section = sections.find(s => s.id === entry.target.id);
        if (section) {
          const url = section.hash ? section.hash : window.location.pathname;
          history.replaceState(null, '', url || '/');
        }
      }
    });
  }, { threshold: 0.4 });
  sections.forEach(s => {
    const el = document.getElementById(s.id);
    if (el) urlObserver.observe(el);
  });
</script>





</Layout>

<style>
  @reference "../styles/global.css";

  /* SVG mockup stroke variables — different values per theme */
  :root {
    --mockup-s1: rgba(0, 0, 0, 0.92);
    --mockup-s2: rgba(0, 0, 0, 0.75);
    --mockup-s3: rgba(0, 0, 0, 0.58);
    --mockup-s4: rgba(0, 0, 0, 0.42);
  }
  :global(.dark) {
    --mockup-s1: rgba(255, 255, 255, 0.95);
    --mockup-s2: rgba(255, 255, 255, 0.78);
    --mockup-s3: rgba(255, 255, 255, 0.60);
    --mockup-s4: rgba(255, 255, 255, 0.44);
  }

  .main {
    @apply max-w-4xl mx-auto px-6;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    @apply min-h-screen pt-16;
  }













  .hero-stack {
    @apply flex flex-wrap gap-3 mt-10 items-end;
    overflow: visible;
  }

  .stack-bubble {
    position: relative;
    overflow: visible;
  }



  /* original */
  .stack-bubble {
    @apply w-12 h-12 rounded-full border border-zinc-200 bg-zinc-100 flex items-center justify-center p-2 transition-transform hover:scale-110;
  }

  :global(.dark) .stack-bubble {
    @apply border-zinc-700 bg-zinc-800;
  }

  .stack-more {
    @apply w-12 h-12 rounded-full border border-zinc-200 bg-zinc-100 flex items-center justify-center text-sm text-zinc-500 font-medium cursor-default;
  }

  :global(.dark) .stack-more {
    @apply border-zinc-700 bg-zinc-800 text-zinc-400;
  }

  .stack-bubble img {
    @apply w-full h-full object-contain;
  }



  .hero-greeting {
    @apply text-zinc-500 mb-2;
  }

  :global(.dark) .hero-greeting {
    @apply text-zinc-400;
  }

  .hero-name {
    @apply font-bold text-zinc-900 mb-4;
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  :global(.dark) .hero-name {
    @apply text-white;
  }

  .hero-role {
    @apply text-xl text-zinc-600 mb-4;
  }

  .hero-bio {
    @apply text-zinc-500 mb-8 max-w-md leading-relaxed;
  }

  :global(.dark) .hero-bio {
    @apply text-zinc-400;
  }

  :global(.dark) .hero-role {
    @apply text-zinc-400;
  }

  .hero-links {
    @apply flex gap-4;
  }

  .hero-link {
    @apply text-sm text-zinc-700 no-underline border border-zinc-300 rounded-full px-4 py-2 transition-all hover:border-zinc-900 hover:text-zinc-900;
    min-width: 100px;
    text-align: center;
  }

  :global(.dark) .hero-link {
    @apply text-zinc-300 border-zinc-600 hover:border-white hover:text-white;
  }

  .section {
    @apply py-16;
  }

  .section-title {
    @apply text-2xl font-bold text-zinc-900 mb-6;
  }

  :global(.dark) .section-title {
    @apply text-white;
  }

  .section-text {
    @apply text-zinc-600 leading-relaxed max-w-2xl;
  }

  :global(.dark) .section-text {
    @apply text-zinc-400;
  }


  /* Experience section */
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 2px solid #e4e4e7;
    padding-left: 1.5rem;
    margin-left: 0.25rem;
  }
  :global(.dark) .exp-list { border-color: #3f3f46; }

  .exp-item {
    position: relative;
    padding-bottom: 2rem;
  }
  .exp-item::before {
    content: '';
    position: absolute;
    left: -1.625rem;
    top: 0.35rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #a1a1aa;
    border: 2px solid white;
  }
  :global(.dark) .exp-item::before { background: #52525b; border-color: #18181b; }
  .exp-item:first-child::before { background: #18181b; }
  :global(.dark) .exp-item:first-child::before { background: white; }

  .exp-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .exp-company { font-size: 0.9375rem; font-weight: 600; color: #18181b; }
  :global(.dark) .exp-company { color: white; }
  .exp-period { font-size: 0.75rem; color: #a1a1aa; white-space: nowrap; }
  .exp-role { display: block; font-size: 0.8125rem; color: #71717a; margin-top: 0.125rem; margin-bottom: 0.5rem; }
  :global(.dark) .exp-role { color: #a1a1aa; }

  .exp-stack { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .exp-stack span { font-size: 0.6875rem; background: #f4f4f5; color: #52525b; border-radius: 4px; padding: 2px 8px; }
  :global(.dark) .exp-stack span { background: #27272a; color: #a1a1aa; }

  .exp-item--earlier { padding-bottom: 0; }
  .exp-item--earlier::before { background: #d4d4d8; }
  :global(.dark) .exp-item--earlier::before { background: #3f3f46; }
  .exp-earlier-label { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #a1a1aa; display: block; margin-bottom: 0.25rem; }
  .exp-earlier-desc { font-size: 0.8125rem; color: #71717a; line-height: 1.6; }
  :global(.dark) .exp-earlier-desc { color: #71717a; }

  .projects-grid {
    @apply grid gap-4 sm:grid-cols-2;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #52525b;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: bounce 2s infinite;
    cursor: pointer;
    text-decoration: none;
  }

  :global(.dark) .hero-scroll {
    color: #a1a1aa;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }


  .hero-left {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-right {
    position: relative;
    width: 420px;
    min-height: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .device-mockups-wrap {
    position: relative;
    height: 260px;
    flex-shrink: 0;
  }

  .device-mockups {
    position: relative;
    pointer-events: none;
    height: 260px;
  }

  .device-laptop {
    position: absolute;
    top: 10px;
    left: 0;
    width: 320px;
    color: #e4e4e7;
    opacity: 0.6;
  }

  :global(.dark) .device-laptop {
    color: #3f3f46;
    opacity: 0.7;
  }

  .device-phone {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 80px;
    color: #d4d4d8;
    opacity: 0.6;
  }

  :global(.dark) .device-phone {
    color: #52525b;
    opacity: 0.7;
  }


  .hero-icons-grid {
    position: relative;
    width: 308px;
    height: 308px;
  }

  .hero-icons-grid .stack-bubble {
    position: absolute;
  }


  .hero-icons-grid .stack-bubble:nth-child(1)  { left: 106px; top: 6px;   }
  .hero-icons-grid .stack-bubble:nth-child(2)  { left: 156px; top: 19px;  }
  .hero-icons-grid .stack-bubble:nth-child(3)  { left: 193px; top: 56px;  }
  .hero-icons-grid .stack-bubble:nth-child(4)  { left: 206px; top: 106px; }
  .hero-icons-grid .stack-bubble:nth-child(5)  { left: 193px; top: 156px; }
  .hero-icons-grid .stack-bubble:nth-child(6)  { left: 156px; top: 193px; }
  .hero-icons-grid .stack-bubble:nth-child(7)  { left: 106px; top: 206px; }
  .hero-icons-grid .stack-bubble:nth-child(8)  { left: 56px;  top: 193px; }
  .hero-icons-grid .stack-bubble:nth-child(9)  { left: 19px;  top: 156px; }
  .hero-icons-grid .stack-bubble:nth-child(10) { left: 6px;   top: 106px; }
  .hero-icons-grid .stack-bubble:nth-child(11) { left: 19px;  top: 56px;  }
  .hero-icons-grid .stack-bubble:nth-child(12) { left: 56px;  top: 19px;  }

  @media (max-width: 768px) {
    .hero-right { display: none; }
    .hero-icons-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; }
    .hero-icons-row .stack-bubble-sm { display: flex; }
    .hero { flex-direction: column; align-items: center; text-align: center; padding-top: 4rem; min-height: auto; padding-bottom: 2rem; }
    .hero-left { align-items: center; }
    .hero-bio { text-align: center; max-width: 100%; }
    .hero-links { justify-content: center; }
    .hero-name { font-size: 2.5rem; line-height: 1.2; }
    .hero-bio { max-width: 100%; }
