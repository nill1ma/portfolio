---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout>
  <Header />

  <main class="main">
    <section id="hero" class="hero">
      <p class="hero-greeting" data-i18n="hero.greeting">Olá, meu nome é</p>
      <h1 class="hero-name">Avanilson Santos</h1>
      <p class="hero-role" data-i18n="hero.role">Senior Frontend Developer</p>
      <div class="hero-links">
        <a href="https://github.com/nill1ma" target="_blank" rel="noopener noreferrer" class="hero-link" aria-label="GitHub de Avanilson Santos">GitHub</a>
        <a href="https://www.linkedin.com/in/avanilson-santos-88113768" target="_blank" rel="noopener noreferrer" class="hero-link" aria-label="LinkedIn de Avanilson Santos">LinkedIn</a>
      </div>
      <div class="hero-stack">
        <div class="stack-bubble" data-tooltip="React"><img src="/icons/react.svg" alt="React" /></div>
        <div class="stack-bubble" data-tooltip="Next.js"><img src="/icons/nextjs.svg" alt="Next.js" /></div>
        <div class="stack-bubble" data-tooltip="JavaScript"><img src="/icons/javascript.svg" alt="JavaScript" /></div>
        <div class="stack-bubble" data-tooltip="TypeScript"><img src="/icons/typescript.svg" alt="TypeScript" /></div>
        <div class="stack-bubble" data-tooltip="Tailwind CSS"><img src="/icons/tailwind.svg" alt="Tailwind CSS" /></div>
        <div class="stack-bubble" data-tooltip="Node.js"><img src="/icons/nodejs.svg" alt="Node.js" /></div>
        <div class="stack-bubble" data-tooltip="Supabase"><img src="/icons/supabase.svg" alt="Supabase" /></div>
        <div class="stack-bubble" data-tooltip="Express.js"><img src="/icons/express.svg" alt="Express.js" /></div>
        <div class="stack-bubble" data-tooltip="NestJS"><img src="/icons/nestjs.svg" alt="NestJS" /></div>
        <div class="stack-bubble" data-tooltip="Styled Components"><img src="/icons/styledcomponents.svg" alt="Styled Components" /></div>
        <div class="stack-bubble" data-tooltip="Vercel"><img src="/icons/vercel.svg" alt="Vercel" /></div>
      </div>
    </section>

    <section id="sobre" class="section">
      <h2 class="section-title" data-i18n="about.title">Sobre</h2>
      <p class="section-text" data-i18n="about.text">
        Desenvolvedor Frontend Sênior com mais de 10 anos de experiência construindo interfaces modernas com React, Next.js e TypeScript. Apaixonado por performance, acessibilidade e boas práticas de desenvolvimento.
      </p>
    </section>

    <section id="projetos" class="section">
      <h2 class="section-title" data-i18n="projects.title">Projetos</h2>
      <div class="projects-grid">
        <ProjectCard
          name="monthctrl-web"
          image="/images/monthctrl.jpg"
          description="Gerenciador de tarefas mensais com foco em produtividade e organização pessoal."
          i18nKey="projects.monthctrl.description"
          stack={["Next.js", "TypeScript", "Tailwind CSS"]}
          githubUrl="https://github.com/nill1ma/monthctrl-web"
          liveUrl="https://monthctrl-app.vercel.app/login"
        />
        <ProjectCard
          name="awakr"
          image="/images/awakr.jpg"
          description="Site institucional para criação de sites para restaurantes e negócios locais, com CMS Sanity, domínio próprio e PWA."
          i18nKey="projects.awakr.description"
          stack={["Astro", "Sanity", "Tailwind CSS", "Cloudflare"]}
          liveUrl="https://awakr.app"
        />
        <ProjectCard
          name="awake-ui"
          image="/images/awake-ui.jpg"
          description="Biblioteca de componentes UI para React, inspirada no Material UI, para uso em projetos pessoais e profissionais."
          i18nKey="projects.awakeui.description"
          stack={["React", "TypeScript", "Tailwind CSS"]}
          githubUrl="https://github.com/nill1ma/awake-ui"
          liveUrl="https://awake-ui.vercel.app"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .main {
    @apply max-w-4xl mx-auto px-6 pt-24;
  }

  .hero {
    @apply min-h-screen flex flex-col justify-center;
  }













  .hero-stack {
    @apply flex flex-wrap gap-3 mt-10 items-end;
  }

  .stack-bubble {
    position: relative;
  }

  .stack-bubble[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: #18181b;
    color: #fff;
    font-size: 0.7rem;
    white-space: nowrap;
    padding: 3px 8px;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .stack-bubble[data-tooltip]:hover::after {
    opacity: 1;
  }

  /* original */
  .stack-bubble {
    @apply w-12 h-12 rounded-2xl border border-zinc-200 bg-zinc-100 flex items-center justify-center p-2 transition-transform hover:scale-110;
  }

  :global(.dark) .stack-bubble {
    @apply border-zinc-700 bg-zinc-800;
  }

  .stack-more {
    @apply w-12 h-12 rounded-2xl border border-zinc-200 bg-zinc-100 flex items-center justify-center text-sm text-zinc-500 font-medium cursor-default;
  }

  :global(.dark) .stack-more {
    @apply border-zinc-700 bg-zinc-800 text-zinc-400;
  }

  .stack-bubble img {
    @apply w-full h-full object-contain;
  }



  .hero-greeting {
    @apply text-zinc-500 mb-2;
  }

  :global(.dark) .hero-greeting {
    @apply text-zinc-400;
  }

  .hero-name {
    @apply text-5xl font-bold text-zinc-900 mb-4;
  }

  :global(.dark) .hero-name {
    @apply text-white;
  }

  .hero-role {
    @apply text-xl text-zinc-600 mb-8;
  }

  :global(.dark) .hero-role {
    @apply text-zinc-400;
  }

  .hero-links {
    @apply flex gap-4;
  }

  .hero-link {
    @apply text-sm text-zinc-700 no-underline border border-zinc-300 rounded-full px-4 py-2 transition-all hover:border-zinc-900 hover:text-zinc-900;
  }

  :global(.dark) .hero-link {
    @apply text-zinc-300 border-zinc-600 hover:border-white hover:text-white;
  }

  .section {
    @apply py-16;
  }

  .section-title {
    @apply text-2xl font-bold text-zinc-900 mb-6;
  }

  :global(.dark) .section-title {
    @apply text-white;
  }

  .section-text {
    @apply text-zinc-600 leading-relaxed max-w-2xl;
  }

  :global(.dark) .section-text {
    @apply text-zinc-400;
  }

  .projects-grid {
    @apply grid gap-4 sm:grid-cols-2;
  }
</style>
