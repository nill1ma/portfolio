---
interface Props {
  name: string;
  description: string;
  stack: string[];
  githubUrl?: string;
  liveUrl?: string;
  i18nKey?: string;
  image?: string;
}

const { name, description, stack, githubUrl, liveUrl, i18nKey, image } = Astro.props;
---

<div class="card">
  {image && (
    <div class="card-image-wrap">
      <img src={image} alt={name} class="card-image" loading="lazy" />
      <div class="card-overlay">
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="overlay-btn" aria-label={`Ver código do ${name} no GitHub`}>GitHub</a>
        )}
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="overlay-btn overlay-btn--primary" aria-label={`Ver ${name} ao vivo`}>Ver projeto</a>
        )}
      </div>
    </div>
  )}

  <div class="card-body">
    <h3 class="card-title">{name}</h3>
    <p class="card-description" data-i18n={i18nKey}>{description}</p>

    <div class="card-stack">
      {stack.map(tech => (
        <span class="card-badge">{tech}</span>
      ))}
    </div>

    <div class="card-links">
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`Ver código do ${name} no GitHub`}>GitHub →</a>
      )}
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`Ver ${name} ao vivo`}>Ver projeto →</a>
      )}
    </div>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .card {
    @apply border border-zinc-200 rounded-xl overflow-hidden transition-all duration-300;
  }
  .card:hover {
    @apply border-zinc-400 shadow-xl;
    transform: translateY(-4px);
  }

  :global(.dark) .card {
    @apply border-zinc-800;
  }
  :global(.dark) .card:hover {
    @apply border-zinc-600 shadow-zinc-900/60;
  }

  .card-image-wrap {
    @apply w-full h-44 overflow-hidden bg-zinc-100 relative;
  }
  :global(.dark) .card-image-wrap {
    @apply bg-zinc-800;
  }

  .card-image {
    @apply w-full h-full object-cover object-top transition-transform duration-500;
  }
  .card:hover .card-image {
    @apply scale-105;
  }

  /* Overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-btn {
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.7);
    color: white;
    background: transparent;
    transition: background 0.2s, border-color 0.2s;
  }
  .overlay-btn:hover {
    background: rgba(255,255,255,0.15);
    border-color: white;
  }
  .overlay-btn--primary {
    background: white;
    color: #18181b;
    border-color: white;
  }
  .overlay-btn--primary:hover {
    background: #e4e4e7;
  }

  .card-body {
    @apply p-6;
  }

  .card-title {
    @apply text-lg font-semibold text-zinc-900 mb-2;
  }
  :global(.dark) .card-title { @apply text-white; }

  .card-description {
    @apply text-sm text-zinc-600 mb-4 leading-relaxed;
  }
  :global(.dark) .card-description { @apply text-zinc-400; }

  .card-stack {
    @apply flex flex-wrap gap-2 mb-6;
  }

  .card-badge {
    @apply text-xs px-2 py-1 rounded-md bg-zinc-100 text-zinc-600;
  }
  :global(.dark) .card-badge { @apply bg-zinc-800 text-zinc-400; }

  .card-links {
    @apply flex gap-4;
  }

  .card-link {
    @apply text-sm text-zinc-600 no-underline transition-colors hover:text-zinc-900;
  }
  :global(.dark) .card-link { @apply text-zinc-400 hover:text-white; }
</style>
