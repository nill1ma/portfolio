---
---

<header class="header">
  <div class="header-inner">
    <span class="header-name">Avanilson Santos</span>

    <nav class="nav">
      <a href="#sobre" class="nav-link" data-i18n="nav.about">Sobre</a>
      <a href="#projetos" class="nav-link" data-i18n="nav.projects">Projetos</a>

      <div class="lang-switcher">
        <button class="lang-btn" data-lang="pt" aria-label="Mudar idioma para Português">PT</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="en" aria-label="Switch language to English">EN</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="es" aria-label="Cambiar idioma a Español">ES</button>
      </div>

      <button id="theme-toggle" class="theme-btn" aria-label="Alternar tema">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-sun">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-moon">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  import { translations, type Language } from '../i18n/translations';

  // Tema
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Idioma
  const savedLang = (localStorage.getItem('lang') ?? 'pt') as Language;
  applyLanguage(savedLang);

  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang') as Language;
      localStorage.setItem('lang', lang);
      applyLanguage(lang);
    });
  });

  function applyLanguage(lang: Language) {
    const t = translations[lang];

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('lang-btn--active', btn.getAttribute('data-lang') === lang);
    });

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n')!;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t);
      if (value) el.textContent = value;
    });
  }
</script>

<style>
  @reference "../styles/global.css";

  .header {
    @apply fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-zinc-100;
  }

  :global(.dark) .header {
    @apply bg-zinc-900/80 border-zinc-800;
  }

  .header-inner {
    @apply max-w-4xl mx-auto px-6 h-14 flex items-center justify-between;
  }

  .header-name {
    @apply text-sm font-semibold text-zinc-900;
  }

  :global(.dark) .header-name {
    @apply text-white;
  }

  .nav {
    @apply flex items-center gap-6;
  }

  .nav-link {
    @apply text-sm text-zinc-600 no-underline transition-colors hover:text-zinc-900;
  }

  :global(.dark) .nav-link {
    @apply text-zinc-400 hover:text-white;
  }

  .theme-btn {
    @apply bg-transparent border-0 cursor-pointer p-1 text-zinc-600 transition-colors hover:text-zinc-900 flex items-center;
  }

  :global(.dark) .theme-btn {
    @apply text-zinc-400 hover:text-white;
  }

  .icon-sun {
    @apply block;
  }

  .icon-moon {
    @apply hidden;
  }

  :global(.dark) .icon-sun {
    @apply hidden;
  }

  :global(.dark) .icon-moon {
    @apply block;
  }

  .lang-switcher {
    @apply flex items-center gap-1;
  }

  .lang-divider {
    @apply text-zinc-300 text-xs;
  }

  :global(.dark) .lang-divider {
    @apply text-zinc-700;
  }

  .lang-btn {
    @apply text-xs bg-transparent border-0 cursor-pointer text-zinc-400 transition-colors hover:text-zinc-900 p-0;
  }

  :global(.dark) .lang-btn {
    @apply text-zinc-600 hover:text-white;
  }

  .lang-btn--active {
    @apply text-zinc-900 font-semibold;
  }

  :global(.dark) .lang-btn--active {
    @apply text-white;
  }
</style>
