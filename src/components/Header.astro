---
---

<header class="header">
  <div class="header-inner">
    <span class="header-name">Avanilson Santos</span>

    <!-- Desktop nav -->
    <nav class="desktop-nav">
      <a href="#sobre" class="nav-link" data-i18n="nav.about">Sobre</a>
      <a href="#projetos" class="nav-link" data-i18n="nav.projects">Projetos</a>
      <div class="lang-switcher">
        <button class="lang-btn" data-lang="pt" aria-label="Mudar idioma para Português">PT</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="en" aria-label="Switch language to English">EN</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="es" aria-label="Cambiar idioma a Español">ES</button>
      </div>
      <button id="theme-toggle" class="theme-btn" aria-label="Alternar tema">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-sun" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-moon" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </nav>

    <!-- Mobile: theme + install + hamburger -->
    <div class="mobile-controls">
      <div class="lang-switcher">
        <button class="lang-btn" data-lang="pt" aria-label="Mudar idioma para Português">PT</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="en" aria-label="Switch language to English">EN</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button class="lang-btn" data-lang="es" aria-label="Cambiar idioma a Español">ES</button>
      </div>
      <button id="pwa-install-btn" class="pwa-btn hidden" aria-label="Instalar app">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Instalar</span>
      </button>
      <button id="theme-toggle-mobile" class="theme-btn" aria-label="Alternar tema">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-sun" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-moon" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
      <button id="menu-toggle" class="menu-btn" aria-label="Abrir menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-menu" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-close hidden" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown: só links de nav -->
  <div id="mobile-menu" class="mobile-menu hidden">
    <a href="#sobre" class="mobile-link" data-i18n="nav.about">Sobre</a>
    <a href="#projetos" class="mobile-link" data-i18n="nav.projects">Projetos</a>
  </div>
</header>

<script>
  import { translations, type Language } from '../i18n/translations';

  // Tema
  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Idioma
  const savedLang = (localStorage.getItem('lang') ?? 'pt') as Language;
  applyLanguage(savedLang);
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang') as Language;
      localStorage.setItem('lang', lang);
      applyLanguage(lang);
    });
  });
  function applyLanguage(lang: Language) {
    const t = translations[lang];
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('lang-btn--active', btn.getAttribute('data-lang') === lang);
    });
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n')!;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t);
      if (value) el.textContent = value;
    });
  }

  // Hamburger
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.querySelector('.icon-menu')?.classList.toggle('hidden', isOpen);
    menuToggle.querySelector('.icon-close')?.classList.toggle('hidden', !isOpen);
  });
  mobileMenu?.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
      menuToggle?.querySelector('.icon-menu')?.classList.remove('hidden');
      menuToggle?.querySelector('.icon-close')?.classList.add('hidden');
    });
  });

  // PWA install — só mobile/tablet, não em standalone
  const isStandalone =
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as any).standalone === true;
  const isMobileTablet = window.matchMedia('(max-width: 1024px)').matches;
  let deferredPrompt: any = null;
  const installBtn = document.getElementById('pwa-install-btn');
  if (!isStandalone && isMobileTablet) {
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      installBtn?.classList.remove('hidden');
    });
  }
  installBtn?.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') installBtn.classList.add('hidden');
    deferredPrompt = null;
  });
  window.addEventListener('appinstalled', () => {
    installBtn?.classList.add('hidden');
    deferredPrompt = null;
  });
</script>

<style>
  @reference "../styles/global.css";

  .header {
    @apply fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-zinc-100;
  }
  :global(.dark) .header { @apply bg-zinc-900/80 border-zinc-800; }

  .header-inner {
    @apply max-w-4xl mx-auto px-6 h-14 flex items-center justify-between;
  }

  .header-name { @apply text-sm font-semibold text-zinc-900; }
  :global(.dark) .header-name { @apply text-white; }

  .desktop-nav { @apply flex items-center gap-6; }
  .mobile-controls { @apply hidden items-center gap-3; }

  @media (max-width: 768px) {
    .desktop-nav { @apply hidden; }
    .mobile-controls { @apply flex; }
  }

  .mobile-menu {
    border-top: 1px solid #e4e4e7;
    background: white;
    padding: 0.25rem 1.5rem 0.75rem;
    display: flex;
    flex-direction: column;
  }
  :global(.dark) .mobile-menu { background: #18181b; border-color: #3f3f46; }
  .mobile-menu.hidden { display: none !important; }

  .mobile-link {
    @apply text-base text-zinc-700 no-underline py-3 border-b border-zinc-100;
  }
  :global(.dark) .mobile-link { @apply text-zinc-300 border-zinc-800; }
  .mobile-link:last-child { border-bottom: none; }

  .nav-link { @apply text-sm text-zinc-600 no-underline transition-colors hover:text-zinc-900; }
  :global(.dark) .nav-link { @apply text-zinc-400 hover:text-white; }

  .theme-btn { @apply bg-transparent border-0 cursor-pointer p-1 text-zinc-600 transition-colors hover:text-zinc-900 flex items-center; }
  :global(.dark) .theme-btn { @apply text-zinc-400 hover:text-white; }

  .icon-sun { @apply block; }
  .icon-moon { @apply hidden; }
  :global(.dark) .icon-sun { @apply hidden; }
  :global(.dark) .icon-moon { @apply block; }

  .menu-btn { @apply bg-transparent border-0 cursor-pointer p-1 text-zinc-700 flex items-center; }
  :global(.dark) .menu-btn { @apply text-zinc-300; }

  .lang-switcher { @apply flex items-center gap-1; }
  .lang-divider { @apply text-zinc-300 text-xs; }
  :global(.dark) .lang-divider { @apply text-zinc-700; }

  .lang-btn { @apply text-xs bg-transparent border-0 cursor-pointer text-zinc-400 transition-colors hover:text-zinc-900 p-0; }
  :global(.dark) .lang-btn { @apply text-zinc-600 hover:text-white; }
  .lang-btn--active { @apply text-zinc-900 font-semibold; }
  :global(.dark) .lang-btn--active { @apply text-white; }

  .pwa-btn {
    @apply flex items-center gap-1.5 text-xs bg-transparent border border-zinc-300 rounded-full px-3 py-1.5 cursor-pointer text-zinc-700 transition-colors hover:border-zinc-900 hover:text-zinc-900;
  }
  :global(.dark) .pwa-btn { @apply border-zinc-600 text-zinc-300 hover:border-white hover:text-white; }
</style>
